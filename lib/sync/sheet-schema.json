  "analysis": [
    {
      "name": "Resumen_Mensual",
      "help": "Últimos 12 meses calculados desde las hojas de operación. Ventas = lo vendido (aunque no esté cobrado). Cobrado = dinero recibido (incluye abonos y descuenta reembolsos). Compras de insumos van a inventario y NO son gasto; su costo entra al vender (Costo de lo vendido).",
      "headers": [
        "Mes",
        "Ventas",
        "Cobrado",
        "Costo de lo vendido",
        "Ganancia bruta",
        "Gastos operativos",
        "Resultado estimado",
        "Compras de insumos",
        "Pagos a proveedores",
        "Aportes",
        "Retiros",
        "Pedidos",
        "Meta ventas",
        "% de la meta"
      ],
      "formats": [
        "month",
        "money",
        "money",
        "money",
        "money",
        "money",
        "money",
        "money",
        "money",
        "money",
        "money",
        "int",
        "money",
        "pct"
      ],
      "rows": 12,
      "row_formulas": [
        "=EDATE(DATE(YEAR(TODAY()),MONTH(TODAY()),1),ROW()-13)",
        "=SUMIFS({Ventas.total},{Ventas.sale_date},\">=\"&A{r},{Ventas.sale_date},\"<\"&EDATE(A{r},1),{Ventas.voided},FALSE)",
        "=SUMIFS({Cobros.amount},{Cobros.paid_at},\">=\"&A{r},{Cobros.paid_at},\"<\"&EDATE(A{r},1),{Cobros.voided},FALSE)",
        "=SUMIFS({Ventas.cost},{Ventas.sale_date},\">=\"&A{r},{Ventas.sale_date},\"<\"&EDATE(A{r},1),{Ventas.voided},FALSE)",
        "=B{r}-D{r}",
        "=SUMIFS({Gastos.amount},{Gastos.expense_date},\">=\"&A{r},{Gastos.expense_date},\"<\"&EDATE(A{r},1),{Gastos.voided},FALSE)",
        "=E{r}-F{r}",
        "=SUMIFS({Compras.total},{Compras.purchase_date},\">=\"&A{r},{Compras.purchase_date},\"<\"&EDATE(A{r},1),{Compras.voided},FALSE)",
        "=SUMIFS({Pagos_Proveedor.amount},{Pagos_Proveedor.paid_at},\">=\"&A{r},{Pagos_Proveedor.paid_at},\"<\"&EDATE(A{r},1),{Pagos_Proveedor.voided},FALSE)",
        "=SUMIFS({Aportes_Retiros.amount},{Aportes_Retiros.movement_date},\">=\"&A{r},{Aportes_Retiros.movement_date},\"<\"&EDATE(A{r},1),{Aportes_Retiros.kind},\"aporte\",{Aportes_Retiros.voided},FALSE)",
        "=SUMIFS({Aportes_Retiros.amount},{Aportes_Retiros.movement_date},\">=\"&A{r},{Aportes_Retiros.movement_date},\"<\"&EDATE(A{r},1),{Aportes_Retiros.kind},\"retiro\",{Aportes_Retiros.voided},FALSE)",
        "=COUNTIFS({Pedidos.order_date},\">=\"&A{r},{Pedidos.order_date},\"<\"&EDATE(A{r},1),{Pedidos.status},\"<>cancelado\")",
        "=SUMIFS({Metas.sales_goal},{Metas.month},YEAR(A{r})&\"-\"&TEXT(MONTH(A{r}),\"00\"))",
        "=IF(M{r}>0,B{r}/M{r},\"\")"
      ],
      "total_row": [
        "Total 12 meses",
        "=SUM(B2:B13)",
        "=SUM(C2:C13)",
        "=SUM(D2:D13)",
        "=SUM(E2:E13)",
        "=SUM(F2:F13)",
        "=SUM(G2:G13)",
        "=SUM(H2:H13)",
        "=SUM(I2:I13)",
        "=SUM(J2:J13)",
        "=SUM(K2:K13)",
        "=SUM(L2:L13)",
        "=SUM(M2:M13)",
        "=IF(M14>0,B14/M14,\"\")"
      ]
    },
    {
      "name": "Rentabilidad",
      "help": "Por producto, con el costo histórico guardado en cada venta (subir un ingrediente no cambia el pasado). Las ventas anuladas no cuentan.",
      "headers": [
        "Producto",
        "Unidades vendidas",
        "Ingresos",
        "Costo de lo vendido",
        "Ganancia",
        "Margen real",
        "Precio actual",
        "Costo unitario actual",
        "Margen actual",
        "Estado costeo"
      ],
      "formats": [
        "text",
        "num",
        "money",
        "money",
        "money",
        "pct",
        "money",
        "money",
        "pct",
        "text"
      ],
      "array_formulas": [
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",{Productos.name}))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",SUMIFS({Venta_Detalle.quantity},{Venta_Detalle.product_id},{Productos.id},{Venta_Detalle.voided},FALSE)))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",SUMIFS({Venta_Detalle.line_total},{Venta_Detalle.product_id},{Productos.id},{Venta_Detalle.voided},FALSE)))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",SUMIFS({Venta_Detalle.line_cost},{Venta_Detalle.product_id},{Productos.id},{Venta_Detalle.voided},FALSE)))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",C2:C-D2:D))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",IF(C2:C=0,\"\",E2:E/C2:C)))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",{Productos.sale_price}))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",{Productos.unit_cost}))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",{Productos.margin}))",
        "=ARRAYFORMULA(IF({Productos.id}=\"\",\"\",{Productos.cost_status}))"
      ]
    },
