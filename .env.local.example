# Copia este archivo como ".env.local" (desarrollo) o carga las mismas variables
# en Netlify → Site configuration → Environment variables (producción).
# Este archivo de ejemplo NO contiene credenciales reales: nunca las escribas aquí.

# --- Navegador (públicas) ----------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Solo servidor (secretas: jamás con prefijo NEXT_PUBLIC_) ------------------
# Conexión a la base para la sincronización. Supabase → Project Settings →
# Database → Connection string → "Transaction pooler" (puerto 6543), con la
# contraseña de la base. Mejor aún: un usuario de base dedicado (ver docs/06-despliegue.md).
SUPABASE_DB_URL=

# ID del negocio a sincronizar (= id de la cuenta administradora; ver docs/06-despliegue.md)
SYNC_BUSINESS_ID=

# Cuenta de servicio de Google con la API de Sheets habilitada.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio (campo private_key del JSON), con los \n tal cual.
GOOGLE_PRIVATE_KEY=
# ID de la planilla: lo que va entre /d/ y /edit en la URL de la matriz.
GOOGLE_SHEET_ID=

# Secreto largo y aleatorio para la sincronización programada (cron de Netlify).
SYNC_CRON_SECRET=
